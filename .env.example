# =========================================================
#  Digital Chantier - Configuration d'environnement
#  Copier ce fichier en ".env" et adapter les valeurs.
# =========================================================

# --- Application ---
# En PRODUCTION (Simafri) : APP_ENV=production et APP_DEBUG=false (obligatoire).
APP_ENV=local
APP_DEBUG=true
APP_NAME="Digital Chantier"
APP_URL=http://localhost/BTP_ERP

# Charte graphique (personnalisable sans toucher au code)
# BRAND_COLOR : couleur principale (boutons, liens, logo, elements actifs)
# BRAND_SIGLE : sigle affiche dans le logo (2-3 lettres)
BRAND_COLOR="#2c6ea4"
BRAND_SIGLE="DC"
APP_TIMEZONE=Indian/Antananarivo

# --- Base de donnees (MySQL 8 / MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=btp_erp
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- JWT (IMPORTANT : generer une cle forte et unique en production) ---
JWT_SECRET=changez_moi_cle_dev_a_regenerer_absolument
JWT_ISSUER=btp-erp
# Duree de vie de l'access token, en secondes (900 = 15 minutes)
JWT_ACCESS_TTL=900
# Duree de vie du refresh token, en secondes (604800 = 7 jours)
JWT_REFRESH_TTL=604800

# --- Envoi des e-mails OTP ---
# Renseigner les valeurs donnees par l'hebergeur ou le prestataire SMTP.
# tls = STARTTLS (souvent port 587), ssl = TLS implicite (souvent port 465).
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-user
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME="Digital Chantier"

# --- Notifications e-mail et SMS ---
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_SMS_ENABLED=false
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SENDER_ADDRESS=
# Indicatif par defaut pour les numeros locaux sans indicatif international.
ORANGE_DEFAULT_COUNTRY_CODE=261
